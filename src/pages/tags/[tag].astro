---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { href } from '../../config';
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.flatMap(p => p.data.tags))].map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(p => p.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<Base title={`#${tag}`} description={`${tag} 주제로 쓴 puzzleleaf의 개발 기록`} active="posts" noindex={posts.every(p => p.data.sample)}><div class="tag-page narrow-container"><a class="back-link" href={href()}>← 모든 기록</a><span class="eyebrow">EXPLORE A TOPIC</span><h1>#{tag}</h1><p class="post-count">이 주제로 쓴 {posts.length}개의 기록</p>{posts.map((post, index) => <PostCard post={post} index={index} />)}</div></Base>
