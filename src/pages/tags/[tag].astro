---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getContent } from '../../lib/posts';
import { href } from '../../config';
export async function getStaticPaths() {
  const posts = await getContent();
  return [...new Set(posts.flatMap(p => p.entry.data.tags))].map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(p => p.entry.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<Base title={`#${tag}`} description={`${tag} 주제의 블로그 글과 위키 문서`} active="tags" noindex={posts.every(p => p.entry.data.sample)}><div class="tag-page container"><a class="back-link" href={href('tags/')}>← 전체 태그</a><h1>#{tag}</h1><p class="post-count">블로그 {posts.filter(p => p.kind === 'posts').length}편 · 위키 {posts.filter(p => p.kind === 'wiki').length}개</p>{posts.map((post, index) => <PostCard post={post.entry} kind={post.kind} index={index} />)}</div></Base>
