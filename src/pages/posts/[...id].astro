---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, readingTime } from '../../lib/posts';
import { site, href, formatDate } from '../../config';
export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = (await getPosts()).filter(p => p.id !== post.id).sort((a,b) => Number(b.data.tags.some(t => post.data.tags.includes(t))) - Number(a.data.tags.some(t => post.data.tags.includes(t)))).slice(0,2);
const canonical = new URL(href(`posts/${post.id}/`), Astro.site).href;
const schema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'BlogPosting', '@id': `${canonical}#article`, headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), ...(post.data.updated ? { dateModified: post.data.updated.toISOString() } : {}), author: { '@type': 'Person', '@id': new URL(href('about/'), Astro.site).href + '#person', name: site.author, url: new URL(href('about/'), Astro.site).href, sameAs: [site.github] }, mainEntityOfPage: canonical, image: new URL(href('og.png'), Astro.site).href, inLanguage: 'ko-KR', keywords: post.data.tags.join(', '), articleSection: post.data.category },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: site.title, item: Astro.site?.href }, { '@type': 'ListItem', position: 2, name: post.data.title, item: canonical }] },
  ],
};
---
<Base title={post.data.title} description={post.data.description} type="article" active="posts" noindex={post.data.sample}>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <article class="article-container container">
    <header class="article-top"><a class="back-link" href={href()}>← 모든 기록</a><div class="post-meta"><span class="category-label">{post.data.category}</span><span>·</span>{readingTime(post.body)}분 읽기</div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="article-byline"><a href={href('about/')} class="author-mark" aria-label="작성자 소개"><Icon name="leaf" size={18} /></a><a rel="author" href={href('about/')}>{site.author}</a><span>·</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.updated && <><span>·</span><span>수정 <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time></span></>}</div><div class="post-tags">{post.data.tags.map(tag => <a href={href(`tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}</div></header>
    <div class="article-layout"><div class="article-content">{post.data.sample && <aside class="sample-notice">이 글은 블로그 기능과 작성 형식을 보여주는 샘플입니다. 검색엔진 색인 및 사이트맵에서 제외됩니다.</aside>}<div class="prose"><Content /></div><div class="article-tools"><button id="copy-link">링크 복사</button><a href={href(`raw/${post.id}.md`)}>Markdown으로 읽기 ↗</a><span id="copy-status" role="status"></span></div>{related.length > 0 && <section class="related-section"><h2>이어서 읽을 기록</h2>{related.map(p => <a href={href(`posts/${p.id}/`)}><span>{p.data.category}{p.data.sample ? ' · 샘플' : ''}</span>{p.data.title} →</a>)}</section>}</div>
      {headings.some(h => h.depth === 2) && <nav class="article-toc" aria-label="이 글의 목차"><h2>ON THIS PAGE</h2><ol>{headings.filter(h => h.depth === 2).map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>}
    </div>
  </article>
  <script>
    document.querySelector('#copy-link')?.addEventListener('click', async () => {
      const status = document.querySelector('#copy-status')!;
      try { await navigator.clipboard.writeText(window.location.href); status.textContent = '링크를 복사했어요.'; } catch { status.textContent = '주소 표시줄의 링크를 복사해주세요.'; }
    });
  </script>
</Base>
