---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { href, site } from '../config';
const posts = await getPosts();
const categories = [...new Set(posts.map(p => p.data.category))];
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.title, alternateName: 'puzzleleaf', url: Astro.site?.href, inLanguage: 'ko-KR', author: { '@type': 'Person', name: site.author, url: new URL(href('about/'), Astro.site).href } };
---
<Base active="posts">
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <div class="home-page container">
    <header class="home-intro"><h1>puzzleleaf의 기술블로그</h1><p>개발 지식과 문제 해결 과정을 정리합니다.</p></header>
    <section aria-label="글 목록">
      <div class="list-toolbar"><div class="category-tabs" role="group" aria-label="카테고리 필터"><button class="category-tab selected" data-filter="all" aria-pressed="true">전체 글 <span>{posts.length}</span></button>{categories.map(category => <button class="category-tab" data-filter={category} aria-pressed="false">{category}</button>)}</div><a class="tag-directory-link" href={href('tags/')}>태그별 보기 <span aria-hidden="true">↗</span></a></div>
      <div class="posts-list">{posts.map((post, index) => <PostCard post={post} index={index} />)}</div>
      <p id="filter-status" class="sr-only" role="status"></p>
      {posts.length === 0 && <div class="empty-state"><h2>등록된 글이 없습니다.</h2></div>}
    </section>
  </div>
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    buttons.forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.filter; let count = 0;
      buttons.forEach(tab => { const active = tab === button; tab.classList.toggle('selected', active); tab.setAttribute('aria-pressed', String(active)); });
      document.querySelectorAll<HTMLElement>('.post-row').forEach(row => { row.hidden = filter !== 'all' && row.dataset.category !== filter; if (!row.hidden) count++; });
      document.querySelector('#filter-status')!.textContent = `${filter === 'all' ? '전체' : filter} 글 ${count}개`;
    }));
  </script>
</Base>
