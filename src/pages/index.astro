---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, readingTime } from '../lib/posts';
import { href, site, formatDate } from '../config';
const posts = await getPosts();
const featured = posts.find(p => p.data.featured) || posts[0];
const categories = [...new Set(posts.map(p => p.data.category))];
const tags = [...new Set(posts.flatMap(p => p.data.tags))];
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.title, alternateName: 'puzzleleaf', url: Astro.site?.href, inLanguage: 'ko-KR', author: { '@type': 'Person', name: site.author, url: new URL(href('about/'), Astro.site).href, sameAs: [site.github] } };
---
<Base active="posts">
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <section class="hero container">
    <div class="hero-copy"><div class="eyebrow"><span class="status-dot"></span> DEVELOPMENT LOG <span class="eyebrow-line"></span></div>
      <h1>puzzleleaf의<br /><span>기술블로그</span></h1>
      <p>개발 지식과 구현 과정,<br />문제를 해결한 방법을 정리합니다.</p>
      <a class="text-link" href="#writing">글 목록 보기 <Icon name="arrow" size={17} /></a>
    </div>
    <div class="notebook-art" aria-hidden="true"><span class="art-orbit orbit-one"></span><span class="art-orbit orbit-two"></span><span class="art-spark spark-one">+</span><span class="art-spark spark-two">✳</span><span class="art-coordinate">PUZZLELEAF / DEV NOTES</span>
      <div class="art-paper"><span class="paper-corner"></span><span class="paper-caption">PUZZLELEAF</span><div class="leaf-symbol"><svg viewBox="0 0 160 160"><path d="M129 24C64 7 19 42 30 92c9 42 60 53 86 14 15-23 19-50 13-82Z" fill="currentColor"/><path d="m24 143 83-91M63 100V74m0 26h28" fill="none" stroke="var(--paper)" stroke-width="5" stroke-linecap="round" /></svg></div><div class="paper-rule"></div><span class="paper-title">Development<br />notes.</span><span class="paper-index">BLOG / 2026</span></div>
      <div class="art-code"><span class="code-dots"><i></i><i></i><i></i></span><code><span class="code-muted">// content schema</span><br /><span class="code-purple">type</span> Note = {'{'}<br />&nbsp; title: <span class="code-lime">string</span>;<br />&nbsp; tags: <span class="code-lime">string</span>[];<br />&nbsp; published: <span class="code-lime">boolean</span>;<br />{'}'};</code><span class="code-file">note.ts <span>↗</span></span></div>
    </div>
  </section>
  <div class="container content-layout" id="writing">
    <section class="writing-section" aria-labelledby="writing-heading">
      <div class="section-heading"><h2 id="writing-heading">최근 글<span class="count">{posts.length}</span></h2><span class="mono subdued">LATEST ENTRIES</span></div>
      <div class="category-tabs" role="group" aria-label="카테고리 필터"><button class="category-tab selected" data-filter="all" aria-pressed="true">전체 <span>{posts.length}</span></button>{categories.map(category => <button class="category-tab" data-filter={category} aria-pressed="false">{category} <span>{posts.filter(p => p.data.category === category).length}</span></button>)}</div>
      <div class="posts-list">{posts.map((post, index) => <PostCard post={post} index={index} />)}</div>
      <p id="filter-status" class="sr-only" role="status"></p>
      {posts.length === 0 && <div class="empty-state"><Icon name="book" size={32} /><h3>첫 번째 기록을 기다리고 있어요.</h3><p>곧 새로운 이야기를 전할게요.</p></div>}
      <div class="list-end" aria-hidden="true"><span></span><Icon name="leaf" size={16} /><span></span></div>
    </section>
    <aside class="sidebar" aria-label="블로그 정보">
      <section class="profile-card"><div class="profile-top"><span class="profile-avatar"><Icon name="leaf" size={29} /></span><span class="profile-greeting">ABOUT</span></div><h2>puzzleleaf<span>.</span></h2><p>개발하면서 배운 내용과<br />문제 해결 과정을 기록합니다.</p><a class="text-link" href={href('about/')}>소개 보기 <Icon name="arrow" size={16} /></a><div class="profile-bottom"><Icon name="code" size={13} /> 개발 블로그</div></section>
      <section class="tag-section"><h2><span class="mono">#</span> 태그</h2><div class="tag-cloud">{tags.map(tag => <a href={href(`tags/${encodeURIComponent(tag)}/`)}>{tag}<span>{posts.filter(p => p.data.tags.includes(tag)).length}</span></a>)}</div></section>
      <a class="rss-card" href={href('rss.xml')}><span class="rss-card-icon"><Icon name="rss" size={21} /></span><div><strong>새 글 구독</strong><span>RSS 피드</span></div><Icon name="arrow" size={17} /></a>
      <p class="sidebar-note">Markdown으로 작성하고<br />GitHub Pages로 배포합니다.</p>
    </aside>
  </div>
  {featured && <section class="featured-note container"><div><span class="eyebrow">블로그 안내</span><h2>{featured.data.title}</h2><p>{featured.data.description}</p><div class="post-meta">{featured.data.sample && <span class="sample-label">샘플</span>}<time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time><span>·</span>{readingTime(featured.body)}분 읽기</div></div><a class="round-link" href={href(`posts/${featured.id}/`)} aria-label={`${featured.data.title} 읽기`}><Icon name="arrow" size={24} /></a></section>}
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    buttons.forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.filter; let count = 0;
      buttons.forEach(tab => { const active = tab === button; tab.classList.toggle('selected', active); tab.setAttribute('aria-pressed', String(active)); });
      document.querySelectorAll<HTMLElement>('.post-row').forEach(row => { row.hidden = filter !== 'all' && row.dataset.category !== filter; if (!row.hidden) count++; });
      document.querySelector('#filter-status')!.textContent = `${filter === 'all' ? '전체' : filter} 글 ${count}개`;
    }));
  </script>
</Base>
