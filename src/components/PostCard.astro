---
import type { CollectionEntry } from 'astro:content';
import { href, formatDate } from '../config';
import { readingTime } from '../lib/posts';
import Icon from './Icon.astro';
interface Props { post: CollectionEntry<'posts'>; index: number; }
const { post, index } = Astro.props;
---
<article class="post-row" data-category={post.data.category} data-tags={post.data.tags.join(',')}>
  <span class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <div class="post-row-body">
    <div class="post-meta"><span class="category-label">{post.data.category}</span>{post.data.sample && <span class="sample-label">샘플</span>}<span class="meta-dot">·</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span class="meta-dot">·</span><span>{readingTime(post.body)}분 읽기</span></div>
    <h3><a href={href(`posts/${post.id}/`)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="post-tags">{post.data.tags.map(tag => <a href={href(`tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}</div>
  </div>
  <a class="post-row-arrow" href={href(`posts/${post.id}/`)} aria-label={`${post.data.title} 읽기`}><Icon name="arrow" /></a>
</article>
