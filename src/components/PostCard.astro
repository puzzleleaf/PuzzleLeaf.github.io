---
import type { ContentEntry } from '../lib/posts';
import { href, formatDate } from '../config';
import { readingTime } from '../lib/posts';
interface Props { post: ContentEntry; index?: number; kind?: 'posts' | 'wiki'; }
const { post, kind = 'posts' } = Astro.props;
---
<article class="post-row" data-category={post.data.category} data-tags={post.data.tags.join(',')}>
  <div class="post-row-body">
    <div class="post-meta">{kind === 'wiki' && <span class="content-kind">위키</span>}<span class="category-label">{post.data.category}</span>{post.data.sample && <span class="sample-label">샘플</span>}<span class="meta-dot">·</span><time datetime={(post.data.updated || post.data.date).toISOString()}>{formatDate(post.data.updated || post.data.date)}</time><span class="meta-dot">·</span><span>{readingTime(post.body)}분 읽기</span></div>
    <h2><a href={href(`${kind}/${post.id}/`)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="post-tags">{post.data.tags.map(tag => <a href={href(`tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}</div>
  </div>
</article>
